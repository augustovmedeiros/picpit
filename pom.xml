<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.catalogo</groupId>
    <artifactId>catalogo-midias</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>Catálogo de Livros, Séries e Filmes</name>
    <description>
        Aplicação web (Java, Servlets, JSP/JSTL e JDBC) para catálogo de livros, séries e filmes,
        com foco em tratamento de exceções e validação de dados (Situação-problema 2 - PICPIT).
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <junit.version>5.10.3</junit.version>
        <h2.version>2.2.224</h2.version>
        <!-- O H2 só é empacotado na aplicação com o perfil "demo" (mvn -Pdemo jetty:run) -->
        <h2.scope>test</h2.scope>
        <jetty.version>12.0.15</jetty.version>
    </properties>

    <dependencies>
        <!-- API Servlet 6 / Jakarta EE 10 (fornecida pelo Tomcat 10.1) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL 3.0 (tags c:, fmt:) -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- Driver JDBC do MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

        <!-- Banco em memória: testes de integração do DAO e modo demonstração -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>${h2.scope}</scope>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>catalogo</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <!-- Servidor embutido para desenvolvimento: mvn jetty:run -->
            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <version>${jetty.version}</version>
                <configuration>
                    <webApp>
                        <contextPath>/catalogo</contextPath>
                    </webApp>
                    <httpConnector>
                        <port>8080</port>
                    </httpConnector>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Perfil de demonstração: roda a aplicação com um banco H2 em memória
            (modo de compatibilidade MySQL), sem precisar instalar o MySQL.
            Uso: mvn -Pdemo jetty:run   ->   http://localhost:8080/catalogo
        -->
        <profile>
            <id>demo</id>
            <properties>
                <h2.scope>runtime</h2.scope>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.jetty.ee10</groupId>
                        <artifactId>jetty-ee10-maven-plugin</artifactId>
                        <version>${jetty.version}</version>
                        <configuration>
                            <systemProperties>
                                <catalogo.db.driver>org.h2.Driver</catalogo.db.driver>
                                <catalogo.db.url>jdbc:h2:mem:catalogo;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</catalogo.db.url>
                                <catalogo.db.usuario>sa</catalogo.db.usuario>
                                <catalogo.db.senha>demo</catalogo.db.senha>
                                <catalogo.db.scripts>db/schema.sql,db/dados-exemplo.sql</catalogo.db.scripts>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
